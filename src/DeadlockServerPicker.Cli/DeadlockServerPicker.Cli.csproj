<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dsp</AssemblyName>
    <RootNamespace>DeadlockServerPicker.Cli</RootNamespace>
    <!-- Self-contained only when publishing for a RID, so the test project can reference this one. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeadlockServerPicker.Core\DeadlockServerPicker.Core.csproj" />
  </ItemGroup>
</Project>
